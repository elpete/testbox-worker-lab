/** BoxLang setup and verification invoked through installed CommandBox. */
class {
    function init() {
        variables.root = createObject( "java", "java.io.File" ).init( getCurrentTemplatePath() ).getParentFile().getParentFile().getCanonicalPath() & "/"
        variables.pins = JSONDeserialize( fileRead( variables.root & "dependencies.json" ) )
        return this
    }

    /** Pass an argument array directly, without shell quoting or interpolation. */
    struct function execute( required array args, struct environment = {}, boolean capture = false ) {
        var commandArgs = createObject( "java", "java.util.ArrayList" ).init()
        for ( var arg in args ) commandArgs.add( javaCast( "string", arg ) )
        var builder = createObject( "java", "java.lang.ProcessBuilder" ).init( commandArgs )
        builder.directory( createObject( "java", "java.io.File" ).init( variables.root ) )
        for ( var key in environment ) builder.environment().put( key, environment[ key ].toString() )
        builder.redirectErrorStream( true )
        if ( !capture ) builder.inheritIO()
        var child = builder.start()
        var output = capture ? createObject( "java", "java.lang.String" ).init( child.getInputStream().readAllBytes(), "UTF-8" ).toString() : ""
        var exitCode = child.waitFor()
        return { exitCode: exitCode, output: output }
    }

    function checked( required array args, struct environment = {} ) {
        var result = execute( args, environment )
        if ( result.exitCode != 0 ) throw( message = "Command failed with exit code " & result.exitCode & ": " & args[ 1 ] )
    }

    /** Invoke the already-installed CommandBox binary in the explicitly isolated home. */
    struct function commandBox( required array args, boolean capture = false, struct environment = {} ) {
        var expected = variables.root & ".runtime/commandbox"
        var configured = getSystemSetting( "COMMANDBOX_HOME", "" )
        if ( !len( configured ) || createObject( "java", "java.io.File" ).init( configured ).getCanonicalPath() != createObject( "java", "java.io.File" ).init( expected ).getCanonicalPath() ) throw( message="Set COMMANDBOX_HOME to this checkout's .runtime/commandbox before using box install or box run-script." )
        var commandArgs = [ getSystemSetting( "LAB_COMMANDBOX_BINARY", "box" ) ]
        commandArgs.append( args, true )
        var settings = structCopy( environment )
        settings.COMMANDBOX_HOME = configured
        return execute( commandArgs, settings, capture )
    }

    function ensureDirectory( required string path ) {
        if ( !directoryExists( path ) ) directoryCreate( path, true )
    }

    /** Replace only an existing symlink; refuse to overwrite a real directory. */
    function makeLink( required string target, required string destination ) {
        var files = createObject( "java", "java.nio.file.Files" )
        var dest = createObject( "java", "java.io.File" ).init( destination ).toPath()
        var source = createObject( "java", "java.io.File" ).init( target ).toPath()
        if ( files.isSymbolicLink( dest ) ) files.delete( dest )
        if ( fileExists( destination ) || directoryExists( destination ) ) throw( message="Refusing to overwrite " & destination )
        files.createSymbolicLink( dest, source )
    }

    /** Validate pinned CommandBox packages and wire the application-owned mappings. */
    function setup() {
        var home = getSystemSetting( "COMMANDBOX_HOME", "" )
        // Validation also prevents modifying the user's normal CommandBox CLI.
        var expected = variables.root & ".runtime/commandbox"
        if ( !len(home) || createObject("java","java.io.File").init(home).getCanonicalPath() != createObject("java","java.io.File").init(expected).getCanonicalPath() ) throw(message="Use this checkout's isolated COMMANDBOX_HOME")
        // Installed CommandBox already launched this helper; avoid another CLI JVM for `version`.
        if ( len(getSystemSetting("BOX_SERVER_JVM_JAVAHOME","")) && !createObject("java","java.lang.System").getProperty("java.runtime.version").startsWith("21.0.12.1+1") ) throw(message="Managed CI runtime differs from the pinned shared JRE")
        var cliRoot = home & "/cfml/modules/testbox-cli"
        for ( var item in [ {key:"testbox",dir:variables.root & ".deps/testbox"}, {key:"cli",dir:cliRoot} ] ) {
            for ( var path in variables.pins[ item.key ].integrity ) {
                var fullPath = item.dir & "/" & path
                if ( !fileExists( fullPath ) || lCase( hash( fileReadBinary( fullPath ), "SHA-256" ) ) != variables.pins[ item.key ].integrity[ path ] ) throw( message="Pinned source differs: " & fullPath & ". Run box install --force in the isolated home." )
            }
        }
        makeLink( variables.root & ".deps/testbox", variables.root & "testbox" )
        var cliFramework = cliRoot & "/testbox"
        var cliFrameworkPath = createObject( "java", "java.io.File" ).init( cliFramework ).toPath()
        if ( directoryExists( cliFramework ) && !createObject( "java", "java.nio.file.Files" ).isSymbolicLink( cliFrameworkPath ) ) directoryDelete( cliFramework, true )
        makeLink( variables.root & ".deps/testbox", cliFramework )
        var installedJar = variables.root & ".deps/boxlang-runtime/boxlang-1.18.0.jar"
        if ( !fileExists( installedJar ) || lCase( hash( fileReadBinary( installedJar ), "SHA-256" ) ) != variables.pins.boxlang.sha256 ) throw( message="Pinned worker runtime missing or changed; run box install." )
        var compat = variables.root & ".runtime/boxlang/modules/bx-compat-cfml"
        if ( !directoryExists( compat ) ) throw( message="CFML compatibility module missing; run box install." )
        var toolingCompat = variables.root & ".runtime/tooling/modules/bx-compat-cfml"
        if ( !directoryExists( toolingCompat ) ) directoryCopy( compat, toolingCompat, true )
        var receipt = {testbox:variables.pins.testbox.commit, cli:variables.pins.cli.commit, sourceIntegrityVerified:true, installedCommandBox:true}
        if (len(getSystemSetting("LAB_SETUP_CACHE_KEY",""))) receipt.cache = {key:getSystemSetting("LAB_SETUP_CACHE_KEY"),bootstrapHit:getSystemSetting("LAB_BOOTSTRAP_CACHE_HIT","false") == "true",dependencyHit:getSystemSetting("LAB_DEPENDENCY_CACHE_HIT","false") == "true"}
        fileWrite( variables.root & ".runtime/setup.json", JSONSerialize(receipt) )
        println( "Ready: box server start; box testbox run runner=parallel workers=4" )
    }

    /** Verify every real application bundle and its result totals. */
    function checkReport( required string path ) {
        if ( !createObject( "java", "java.io.File" ).init( path ).isAbsolute() ) path = variables.root & path
        var report = JSONDeserialize( fileRead( path ) )
        if ( report.totalPass != 32 || report.totalFail != 0 || report.totalError != 0 || report.totalSkipped != 0 ) throw( message="Application result totals differ: " & path )
        var expected = directoryList( variables.root & "tests/specs", false, "name", "*Spec.bx" ).map( name => "tests.specs." & listFirst( name, "." ) )
        var actual = report.bundleStats.map( bundle => bundle.path )
        expected.sort( "textnocase" ); actual.sort( "textnocase" )
        if ( expected.len() != 8 || JSONSerialize( expected ) != JSONSerialize( actual ) ) throw( message="Bundle coverage differs: " & path )
        if ( report.keyExists( "parallel" ) && ( !report.passed || !report.parallel.coverageMatched || report.parallel.cancelled || report.parallel.errors.len() ) ) throw( message="Incomplete worker execution: " & path )
        if ( report.keyExists( "sharding" ) && !report.passed ) throw( message="Combined shards did not pass" )
        println( path & ": 32 passes, 8 exact bundles, no failures/errors/skips" )
    }

    /** Verify missing, duplicate and mixed-run reports fail the real CLI. */
    function verifyMerge() {
        var reports = directoryList( variables.root & "results/shards", false, "path", "*.json" )
        if ( reports.len() < 2 ) throw( message="At least two real shard reports are required" )
        for ( var scenario in [ "missing", "duplicate", "mixed-run" ] ) {
            var temp = getTempDirectory() & "worker-lab-merge-" & createUUID()
            ensureDirectory( temp )
            try {
                var count = scenario == "missing" ? reports.len() - 1 : reports.len()
                for ( var i = 1; i <= count; i++ ) fileCopy( reports[ i ], temp & "/" & i & ".json" )
                if ( scenario == "duplicate" ) fileCopy( reports[ 1 ], temp & "/duplicate.json" )
                if ( scenario == "mixed-run" ) {
                    var report = JSONDeserialize( fileRead( temp & "/1.json" ) )
                    report.shard.plan.runId = "different-run"
                    fileWrite( temp & "/1.json", JSONSerialize( report ) )
                }
                var result = commandBox( [ "testbox", "merge", "directory=" & temp ], true )
                if ( result.exitCode == 0 || !find( "Cannot combine CI results", result.output ) ) throw( message="Merge did not reject " & scenario )
                println( scenario & ": correctly rejected by the real CLI" )
            } finally { directoryDelete( temp, true ) }
        }
    }

    /** Guard the authored source boundary, excluding ignored third-party dependencies. */
    function auditSource() {
        var listed = execute( [ "git", "ls-files" ], {}, true )
        if ( listed.exitCode != 0 ) throw( message="Source audit requires a Git checkout" )
        for ( var path in listToArray( listed.output, char( 10 ) ) ) {
            if ( reFindNoCase( "\.(py|pyc|sh|cfc|mjs)$", path ) || path == "package.json" || path == "package-lock.json" ) throw( message="Non-BoxLang executable tooling: " & path )
            if ( left( path, 8 ) == "scripts/" && !reFindNoCase( "\.(bx|bxs)$", path ) ) throw( message="Executable tools must be BoxLang: " & path )
            if ( reFindNoCase( "\.js$", path ) && path != "site.js" ) throw( message="Only browser presentation JavaScript is allowed: " & path )
        }
        println( "PASS: authored application/tooling is BoxLang; no Python, shell wrappers or Node tooling" )
    }

    /** Exercise actual serial/workers/shards and native validation from one clean setup. */
    function smoke() {
        for ( var selection in [ {name:"serial", workers:0}, {name:"parallel-2", workers:2}, {name:"parallel-4", workers:4} ] ) {
            var destination = "results/" & selection.name & ".json"
            var args = [ "testbox", "run", "runner=" & ( selection.workers ? "parallel" : "serial" ), "options:demoDelayMs=300", "outputFile=" & destination ]
            if ( selection.workers ) args.append( [ "workers=" & selection.workers, "interactive=false" ], true )
            if ( commandBox( args ).exitCode != 0 ) throw( message="CLI failed: " & selection.name )
            checkReport( destination )
        }
        var shardDirectory = variables.root & "results/shards"
        if ( directoryExists( shardDirectory ) ) directoryDelete( shardDirectory, true )
        for ( var index = 1; index <= 2; index++ ) {
            if ( commandBox( [ "testbox", "run", "runner=serial", "options:demoDelayMs=300", "shard=" & index & "/2", "shardRunId=boxlang-smoke", "outputFile=results/shards/" & index & ".json" ] ).exitCode != 0 ) throw( message="HTTP shard failed" )
        }
        if ( commandBox( [ "testbox", "merge", "directory=results/shards", "outputFile=results/combined.json" ] ).exitCode != 0 ) throw( message="Native merge failed" )
        checkReport( "results/combined.json" )
        verifyMerge()
        include "../tests/contracts.bxs"
    }

    /** Poll the real native endpoint, with a bounded HTTP and readiness timeout. */
    function waitReady() {
        var client = createObject( "java", "java.net.http.HttpClient" ).newBuilder().connectTimeout( createObject( "java", "java.time.Duration" ).ofSeconds( 2 ) ).build()
        var deadline = getTickCount() + 60000
        while ( getTickCount() < deadline ) {
            try {
                var call = createObject( "java", "java.net.http.HttpRequest" ).newBuilder( createObject( "java", "java.net.URI" ).init( "http://127.0.0.1:8642/tests/runner.parallel.bxm?action=capabilities" ) ).timeout( createObject( "java", "java.time.Duration" ).ofSeconds( 2 ) ).GET().build()
                var response = client.send( call, createObject( "java", "java.net.http.HttpResponse$BodyHandlers" ).ofString() )
                var data = JSONDeserialize( response.body() )
                if ( response.statusCode() == 200 && data.workers && data.cancellation ) { println( "Ready: native worker capabilities" ); return }
            } catch ( any error ) { }
            sleep( 1000 )
        }
        throw( message="Owned demo server was not ready within 60 seconds" )
    }

    /** Dispatch to native tools; nonzero subprocesses remain nonzero. */
    function dispatch( required string action, array args = [] ) {
        if ( action == "setup" ) { setup(); return }
        if ( action == "audit" ) { auditSource(); return }
        if ( action == "smoke" ) { smoke(); return }
        if ( action == "verify-quick" ) { for ( var path in ["results/serial.json","results/parallel-2.json","results/parallel-4.json"] ) checkReport(path); include "../tests/contracts.bxs"; return }
        if ( action == "merge-checks" ) { checkReport("results/combined.json"); verifyMerge(); return }
        if ( action == "measure-case" ) { measureCase( args ); return }
        if ( action == "ci-summary" ) { ciSummary(); return }
        if ( action == "verify-report" ) { if ( args.len() != 1 ) throw( message="verify-report requires a JSON report path" ); checkReport( args[ 1 ] ); return }
        if ( action == "verify-merge" ) { verifyMerge(); return }
        if ( action == "wait-ready" ) { waitReady(); return }
        if ( action == "contracts" ) { include "../tests/contracts.bxs"; return }
        if ( action == "browser-setup" ) { browserSetup(); return }
        if ( action == "browser" ) {
            if ( commandBox( [ "boxlang", "cli", variables.root & "scripts/lab.bxs", "browser-run" ], false, { BX_PLAYWRIGHT_HOME: variables.root & ".runtime/playwright", LAB_BROWSER_LONG: args.len() && args[1] == "long" ? "true" : "false" } ).exitCode != 0 ) throw( message="BoxLang browser verification failed" )
            return
        }
        if ( action == "browser-run" ) { include "browser.bxs"; return }
        throw( message="Unknown action: " & action )
    }

    /** Real CommandBox commands with explicit measured lifecycle boundaries. */
    function clockMs() { return createObject("java","java.lang.System").nanoTime() / 1000000 }

    function measureCase( required array args ) {
        var mode = args.len() ? args[1] : "serial"
        var delayMs = args.len() > 1 ? args[2] : 10000
        if ( !listFind("serial,parallel-2,parallel-4,local-shards,shard-1,shard-2,shard-3,shard-4",mode) || !isNumeric(delayMs) || delayMs != int(delayMs) || delayMs < 0 || delayMs > 30000 ) throw(message="Choose serial, parallel-2/4, local-shards or shard-1/2/3/4 and an integer delay of 0–30000 ms")
        delayMs = int(delayMs)
        ensureDirectory(variables.root & "results/measurements")
        var identity = getSystemSetting("GITHUB_RUN_ID","local") & "-" & getSystemSetting("GITHUB_RUN_ATTEMPT","1") & "-" & getSystemSetting("GITHUB_SHA",createUUID())
        var timing = {mode:mode, delayMs:delayMs, simulatedWait:true, runId:identity, boundary:"Before box server start through box server stop; includes CLI processes, server/JVM startup, readiness, execution and shutdown; excludes package install and outer BoxLang helper bootstrap"}
        var setupReceipt = JSONDeserialize(fileRead(variables.root & ".runtime/setup.json"))
        if (setupReceipt.keyExists("cache")) timing.cache = setupReceipt.cache
        // Ensure a real cold server process. This preflight stop is outside the boundary.
        if ( commandBox(["server","stop"]).exitCode != 0 ) throw(message="Cannot reset the owned measurement server")
        var started = clockMs()
        try {
            if ( commandBox(["server","start","--noSaveSettings"]).exitCode != 0 ) throw(message="Measurement server failed to start")
            waitReady()
            timing.startReadyMs = clockMs() - started
            var executionStarted = clockMs()
            if ( mode == "local-shards" ) {
                var directory = variables.root & "results/measurement-shards"
                if ( directoryExists(directory) ) directoryDelete(directory,true)
                ensureDirectory(directory)
                var children = []
                try {
                    for ( var shard = 1; shard <= 4; shard++ ) {
                        var command = createObject("java","java.util.ArrayList").init()
                        for ( var arg in [getSystemSetting("LAB_COMMANDBOX_BINARY","box"),"testbox","run","runner=serial","shard=" & shard & "/4","shardRunId=" & identity,"options:demoDelayMs=" & delayMs,"outputFile=" & directory & "/" & shard & ".json"] ) command.add(javaCast("string",arg))
                        var builder = createObject("java","java.lang.ProcessBuilder").init(command)
                        builder.directory(createObject("java","java.io.File").init(variables.root))
                        builder.redirectErrorStream(true)
                        builder.redirectOutput(createObject("java","java.io.File").init(variables.root & "results/measurements/local-shard-" & shard & ".log"))
                        children.append(builder.start())
                    }
                    for ( var child in children ) if ( child.waitFor() != 0 ) throw(message="Local HTTP shard failed; inspect measurement logs")
                } finally {
                    for ( var child in children ) if ( child.isAlive() ) { child.destroyForcibly(); child.waitFor() }
                }
                timing.concurrentShardProcessesMs = clockMs() - executionStarted
                if ( commandBox(["testbox","merge","directory=" & directory,"outputFile=results/measurements/local-shards.json"]).exitCode != 0 ) throw(message="Local native shard merge failed")
            } else {
                var command = ["testbox","run","runner=" & (mode.startsWith("parallel") ? "parallel" : "serial"),"options:demoDelayMs=" & delayMs,"outputFile=results/measurements/" & mode & ".json"]
                if ( mode.startsWith("parallel") ) command.append(["workers=" & listLast(mode,"-"),"interactive=false"],true)
                if ( mode.startsWith("shard") ) command.append(["shard=" & listLast(mode,"-") & "/4","shardRunId=" & identity],true)
                if ( commandBox(command).exitCode != 0 ) throw(message="Measured CLI run failed: " & mode)
            }
            timing.testProcessesAndMergeMs = clockMs() - executionStarted
            var report = JSONDeserialize(fileRead(variables.root & "results/measurements/" & mode & ".json"))
            if ( mode.startsWith("shard-") ) {
                if ( report.totalPass != 8 || report.totalFail || report.totalError || report.totalSkipped || report.bundleStats.len() != 2 ) throw(message="Assigned shard did not pass its exact two bundles/eight tests")
            } else checkReport("results/measurements/" & mode & ".json")
            timing.runnerMs = report.totalDuration
            timing.totalPass = report.totalPass
            timing.bundleCount = report.bundleStats.len()
        } finally {
            var stopStarted = clockMs()
            // Always attempt cleanup, even when startup returned a failure after provisioning.
            var stopped = commandBox(["server","stop"])
            timing.serverStopMs = clockMs() - stopStarted
            timing.lifecycleMs = clockMs() - started
            if ( stopped.exitCode != 0 ) throw(message="Measurement server failed to stop")
        }
        fileWrite(variables.root & "results/measurements/" & mode & "-timing.json",JSONSerialize(timing))
        println(JSONSerialize(timing))
    }

    function ciSummary() { new scripts.Summary().validateRuntime(); new scripts.Summary().run() }

    /** CommandBox installs the browser module and launches its native BoxLang installer. */
    function browserSetup() {
        var modules = createObject( "java", "ortus.boxlang.runtime.BoxRuntime" ).getInstance().getRuntimeHome().toString() & "/modules"
        if ( !directoryExists( modules & "/bx-playwright" ) ) {
            if ( commandBox( [ "install", "ID=" & variables.pins.browserModule.url, "directory=" & modules, "save=false", "production=true" ] ).exitCode != 0 ) throw( message="CommandBox browser-module installation failed" )
        }
        if ( commandBox( [ "boxlang", "cli", "module:bxplaywright", "install", "chromium", "--with-deps" ], false, { BX_PLAYWRIGHT_HOME: variables.root & ".runtime/playwright" } ).exitCode != 0 ) throw( message="Browser installation failed" )
    }
}
