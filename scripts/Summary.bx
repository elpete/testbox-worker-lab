/** Standalone native BoxLang summary; no TestBox or CFML compatibility required. */
class {
    function init() {
        variables.root = createObject("java","java.io.File").init(getCurrentTemplatePath()).getParentFile().getParentFile().getCanonicalPath() & "/"
        return this
    }
    function ensureDirectory(required string path) { if (!directoryExists(path)) directoryCreate(path,true) }
    function validateRuntime() {
        var pins = JSONDeserialize(fileRead(variables.root & "dependencies.json"))
        var jar = variables.root & ".deps/boxlang-runtime/boxlang-1.18.0.jar"
        if (!fileExists(jar) || lCase(hash(fileReadBinary(jar),"SHA-256")) != pins.boxlang.sha256) throw(message="Pinned summary runtime checksum differs")
        if (len(getSystemSetting("BOX_SERVER_JVM_JAVAHOME","")) && !createObject("java","java.lang.System").getProperty("java.runtime.version").startsWith("21.0.12.1+1")) throw(message="Summary did not use the pinned registered JRE")
        if (len(getSystemSetting("LAB_SETUP_CACHE_KEY",""))) {
            ensureDirectory(variables.root & ".runtime")
            fileWrite(variables.root & ".runtime/summary-setup.json",JSONSerialize({key:getSystemSetting("LAB_SETUP_CACHE_KEY"),bootstrapHit:getSystemSetting("LAB_BOOTSTRAP_CACHE_HIT","false") == "true",minimalHit:getSystemSetting("LAB_MINIMAL_CACHE_HIT","false") == "true"}))
        }
    }
    function run() {
        var directory = variables.root & "results/ci-input"
        var timings = []
        for ( var path in directoryList(directory,true,"path","*-timing.json") ) timings.append(JSONDeserialize(fileRead(path)))
        if ( timings.len() != 6 ) throw(message="Require serial, parallel-4 and four shard lifecycle timings")
        var serial = timings.filter(t => t.mode == "serial")[1]
        var workers = timings.filter(t => t.mode == "parallel-4")[1]
        if ( serial.delayMs != 10000 || workers.delayMs != serial.delayMs || serial.totalPass != 32 || workers.totalPass != 32 ) throw(message="Comparison workloads differ")
        for ( var timing in timings ) if ( timing.delayMs != serial.delayMs ) throw(message="Shard delay differs")
        var client = createObject("java","java.net.http.HttpClient").newHttpClient()
        var endpoint = "https://api.github.com/repos/" & getSystemSetting("GITHUB_REPOSITORY") & "/actions/runs/" & getSystemSetting("GITHUB_RUN_ID") & "/jobs?per_page=100"
        var builder = createObject("java","java.net.http.HttpRequest").newBuilder(createObject("java","java.net.URI").init(endpoint)).header("Accept","application/vnd.github+json").header("X-GitHub-Api-Version","2022-11-28").timeout(createObject("java","java.time.Duration").ofSeconds(30))
        var token = getSystemSetting("GITHUB_TOKEN","")
        if (len(token)) builder.header("Authorization","Bearer " & token)
        var call = builder.GET().build()
        var response = client.send(call,createObject("java","java.net.http.HttpResponse$BodyHandlers").ofString())
        if ( response.statusCode() != 200 ) throw(message="Cannot read hosted timing boundaries: HTTP " & response.statusCode())
        var jobs = JSONDeserialize(response.body()).jobs
        var shardJobs = jobs.filter(j => j.name.startsWith("shards ("))
        var baselineJob = jobs.filter(j => j.name == "comparison (serial)")[1]
        var workerJob = jobs.filter(j => j.name == "comparison (parallel-4)")[1]
        var mergeJob = jobs.filter(j => j.name == "merge")[1]
        var epoch = instant => createObject("java","java.time.Instant").parse(instant).toEpochMilli()
        if ( shardJobs.len() != 4 ) throw(message="Require four hosted shard jobs")
        for ( var job in shardJobs ) if ( job.conclusion != "success" ) throw(message="Incomplete hosted shard")
        if ( baselineJob.conclusion != "success" || workerJob.conclusion != "success" || mergeJob.conclusion != "success" ) throw(message="Incomplete hosted comparison")
        var firstShard = shardJobs.map(j => epoch(j.started_at)).min()
        var summary = {commit:getSystemSetting("GITHUB_SHA"),delayMs:10000,syntheticWait:true,timings:timings,
            serialJobMs:epoch(baselineJob.completed_at)-epoch(baselineJob.started_at),workerJobMs:epoch(workerJob.completed_at)-epoch(workerJob.started_at),
            shardPathMs:epoch(mergeJob.completed_at)-firstShard,
            hostedBoundary:"Job start through completion; serial/worker jobs include install, helper/bootstrap and artifact upload. Shard path starts at earliest shard job start and ends after merge job completes; includes provisioning, uploads, scheduling gap and merge. Excludes initial runner queue and this summary job. Jobs use different machines; one observation, not a controlled production benchmark."}
        if (fileExists(variables.root & ".runtime/summary-setup.json")) summary.summaryCache = JSONDeserialize(fileRead(variables.root & ".runtime/summary-setup.json"))
        var text = "## Measured synthetic-latency comparison" & char(10) & char(10) & "32 real tests / eight bundles / 10 seconds deliberate waiting per test. Equivalent passing results verified." & char(10) & char(10) & "| Boundary | Serial | Four workers | Four hosted shards + merge |" & char(10) & "| --- | ---: | ---: | ---: |" & char(10) & "| Full hosted job/path (seconds) | " & round(summary.serialJobMs/1000,2) & " | " & round(summary.workerJobMs/1000,2) & " | " & round(summary.shardPathMs/1000,2) & " |" & char(10) & "| CommandBox/server lifecycle (seconds) | " & round(serial.lifecycleMs/1000,2) & " | " & round(workers.lifecycleMs/1000,2) & " | See each shard timing; full path above includes merge |" & char(10) & char(10) & summary.hostedBoundary & char(10) & char(10) & "Workers share one CI machine and create private JVMs. Shards use four independent CI machines. TestBox's combined duration is the longest shard test duration, not the hosted path." & char(10)
        ensureDirectory(variables.root & "results/comparison")
        fileWrite(variables.root & "results/comparison/summary.json",JSONSerialize(summary))
        fileWrite(variables.root & "results/comparison/summary.md",text)
        fileAppend(getSystemSetting("GITHUB_STEP_SUMMARY"),text)
        println(text)
    }

}
