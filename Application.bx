class {
    this.name = "parcel-worker-lab-" & hash( getCurrentTemplatePath() )
    this.sessionManagement = false
    this.mappings[ "/testbox" ] = getDirectoryFromPath( getCurrentTemplatePath() ) & ".deps/testbox"
    this.mappings[ "/tests" ] = getDirectoryFromPath( getCurrentTemplatePath() ) & "tests"
    this.mappings[ "/app" ] = getDirectoryFromPath( getCurrentTemplatePath() ) & "app"
    this.requestTimeout = createTimeSpan( 0, 0, 10, 0 )
}
